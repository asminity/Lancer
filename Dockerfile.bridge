FROM node:20-bullseye-slim

WORKDIR /app

# Install Python & build essentials for PDF / file extraction tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    ca-certificates \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy package manifests from frontend (bridge server lives inside frontend workspace)
COPY frontend/package*.json ./
RUN npm ci

# Copy frontend source code (needed for simulation types & bridge runner)
COPY frontend/ ./

# Expose Bridge HTTP & WebSocket port
EXPOSE 8000

ENV PORT=8000
ENV NODE_ENV=production

CMD ["npx", "tsx", "tools/mock-bridge/server.ts"]

