{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "bridge": {
      "root": "bridge",
      "framework": "fastapi",
      "entrypoint": "autonex_bridge.main:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "bridge"
      }
    },
    {
      "source": "/ws/(.*)",
      "destination": {
        "service": "bridge"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}