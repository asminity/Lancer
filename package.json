{
  "name": "autonex",
  "version": "1.0.0",
  "description": "AUTONEX - Unified autonomous multi-agent coding system and 3D spatial visualizer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "npm --prefix frontend test",
    "check": "npm --prefix frontend run check",
    "bridge": "npm --prefix frontend run bridge",
    "bridge:mock": "npm --prefix frontend run bridge",
    "tape:record": "npm --prefix frontend run tape:record",
    "layout:export": "npm --prefix frontend run layout:export",
    "arkiv:query": "node scripts/reproduce-query.mjs",
    "install:frontend": "npm --prefix frontend install",
    "install:all": "npm --prefix frontend install",
    "start:all": "powershell -ExecutionPolicy Bypass -File scripts/start-all.ps1"
  },
  "keywords": [
    "autonex",
    "ai-agents",
    "threejs",
    "autonomous-agent",
    "3d-office",
    "multi-agent-system"
  ],
