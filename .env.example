# ==============================================================================
# AUTONEX Unified Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend (AUTONEX 3D Virtual Office)
# ------------------------------------------------------------------------------
# Set to 'true' to run fully offline/client-side with synthetic agent simulation.
# Set to 'false' to connect to the Bridge Server over HTTP & WebSocket.
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. Bridge & Provider Gateway (Local Proxy)
# ------------------------------------------------------------------------------
# Bridge HTTP/WebSocket server port
PORT=8000
# Gateway OpenAI-compatible proxy port
GATEWAY_PORT=8787
AUTONEX_BRIDGE=http://127.0.0.1:8787

# ------------------------------------------------------------------------------
# 3. 0G Private Computer Model Access
# ------------------------------------------------------------------------------
# 0G Private Computer (0G Compute) - Unified Decentralized AI Router
# Official Base URL: https://router-api.0g.ai/v1 (OpenAI-compatible)
# Verified Catalog: 79 models (GLM 5.3 Flash, Qwen 3 Coder Flash, Kimi K2.7, DeepSeek V4.1)
ZG_API_KEY=
ZG_BASE_URL=https://router-api.0g.ai/v1
ZG_TRUST_MODE=standard       # standard | verified | private
ZG_TIMEOUT_MS=65000

# ------------------------------------------------------------------------------
# 4. AUTONEX / PAG Autonomous Engine Settings
# ------------------------------------------------------------------------------
# Context tier: 1 (aggressive mask), 2 (moderate), 3 (conservative - default)
PAG_CTX_TIER=3

# Optional local/hosted SearXNG instance for autonomous web search
SEARXNG_URL=

# ------------------------------------------------------------------------------
# 5. Arkiv Network (Decentralized Database Layer)
# ------------------------------------------------------------------------------
# Network: Rabdi DB-Chain Testnet (Chain ID 7794095)
# RPC: https://rpc.rabdi.db-chain.testnet.arkiv.network
# Explorer: https://rabdi.explorer.arkiv.network
# Optional free Access Key to bypass public rate-limits on Rabdi DB-Chain Testnet
# Get your free key at: https://hub.arkiv.network/access-keys
VITE_ARKIV_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 6. Ethereum Swarm (Content-Addressed Context & Deliverable Storage)
# ------------------------------------------------------------------------------
# Public Swarm gateway or local Bee node (e.g., http://localhost:1633)
VITE_SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org
# Optional Postage Batch ID for pinning live files to Bee nodes
VITE_SWARM_POSTAGE_BATCH_ID=
# Network request timeout in milliseconds (default: 15000)
VITE_SWARM_TIMEOUT_MS=15000
