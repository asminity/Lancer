# true  = built-in mock simulator (default)
# false = talk to the real AUTONEX Bridge Server
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000
VITE_ZG_BASE_URL=https://router-api.0g.ai/v1

# Arkiv Network (Rabdi DB-Chain Testnet, Chain ID 7794095)
VITE_ARKIV_ACCESS_KEY=

# Ethereum Swarm (BZZ Content-Addressed Storage)
VITE_SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org
# Optional when using the public ethSwarm gateway above. Required for custom/private Bee gateways.
VITE_SWARM_POSTAGE_BATCH_ID=
VITE_SWARM_TIMEOUT_MS=15000

# Local workspace used by checkpoint Save/Upload and Restore.
# This must be an absolute path on the machine running the AUTONEX app.
# Example (Linux): /home/you/AUTONEX/output/MyProject
# Example (Windows): C:/AUTONEX/output/MyProject
VITE_AUTONEX_WORKSPACE_DIR=
